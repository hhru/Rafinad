tation\/Rafinad\/TestingElement","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestingElement","kind":"identifier"}],"abstract":[{"type":"text","text":"Тестируемое представление UI-компонента или экрана."}],"title":"TestingElement","kind":"symbol"},"doc://ru.hh.Rafinad/documentation/Rafinad/ScreenAccessibility/init()":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"type":"topic","abstract":[{"text":"Создает экземпляр accessibility-схемы.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/ru.hh.Rafinad\/documentation\/Rafinad\/ScreenAccessibility\/init()","url":"\/documentation\/rafinad\/screenaccessibility\/init()","title":"init()"}}}